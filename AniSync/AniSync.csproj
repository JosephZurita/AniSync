<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DevelopmentBuildNumber Condition="'$(DevelopmentBuildNumber)' == ''">0</DevelopmentBuildNumber>
        <Version>1.0.0-dev.$(DevelopmentBuildNumber)</Version>
        <AssemblyVersion>1.0.0.$(DevelopmentBuildNumber)</AssemblyVersion>
        <FileVersion>1.0.0.$(DevelopmentBuildNumber)</FileVersion>
        <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
        <ReleaseChannel>Dev</ReleaseChannel>
        <RepositoryUrl>https://github.com/JosephZurita/AniSync</RepositoryUrl>
    </PropertyGroup>

    <Target Name="ValidateDevelopmentBuildNumber" BeforeTargets="PrepareForBuild">
        <PropertyGroup>
            <_IsNumericDevelopmentBuildNumber>$([System.Text.RegularExpressions.Regex]::IsMatch('$(DevelopmentBuildNumber)', '^[0-9]+$'))</_IsNumericDevelopmentBuildNumber>
        </PropertyGroup>
        <Error Condition="'$(_IsNumericDevelopmentBuildNumber)' != 'True'"
               Text="DevelopmentBuildNumber must be a non-negative integer derived from GITHUB_RUN_NUMBER; received '$(DevelopmentBuildNumber)'." />
        <Error Condition="'$(_IsNumericDevelopmentBuildNumber)' == 'True' And $([System.Int32]::Parse('$(DevelopmentBuildNumber)')) &gt; 65534"
               Text="DevelopmentBuildNumber $(DevelopmentBuildNumber) exceeds the CLR AssemblyVersion revision limit of 65534; no package was produced." />
    </Target>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <ItemGroup>
        <!-- Provided by the Shoko host at runtime; do not ship a copy. -->
        <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" ExcludeAssets="runtime" />
        <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.81" />
        <PackageReference Include="Shoko.BuildTools.Targets" Version="0.2.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AniSync.Tests" />
    </ItemGroup>
    
    <ItemGroup>
        <!-- Embed the built SPA; LogicalName keeps a stable "app/<path>" lookup key.
             Build the client first (./build.sh or `npm run build` in client/). -->
        <EmbeddedResource Include="wwwroot\app\**\*">
            <LogicalName>app/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>


    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(ProgramData)\ShokoServer\plugins') OR Exists('$(ProgramData)/ShokoServer/plugins')">
        <PropertyGroup>
            <ShokoPluginsDir>$(ProgramData)\ShokoServer\plugins</ShokoPluginsDir>
        </PropertyGroup>
        <MakeDir Directories="$(ShokoPluginsDir)" Condition="!Exists('$(ShokoPluginsDir)')" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ShokoPluginsDir)" />
        <Message Text="Plugin copied to: $(ShokoPluginsDir)" Importance="high" />
    </Target>
</Project>
